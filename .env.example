NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Base Sepolia defaults to chain ID 84532. Use 8453 only after audit/mainnet deployment.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0xDEPLOYED_ESCROW_ADDRESS
NEXT_PUBLIC_SCHEDULER_CONTRACT_ADDRESS=0xDEPLOYED_SCHEDULER_ADDRESS
# Official Base Sepolia USDC is used automatically; set these to override/add USDT.
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_USDT_ADDRESS=
